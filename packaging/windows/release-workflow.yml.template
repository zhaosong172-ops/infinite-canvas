name: Windows Release

on:
  push:
    tags: ["v*"]
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: windows-release-${{ github.ref }}
  cancel-in-progress: false

jobs:
  windows-portable:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod

      - uses: oven-sh/setup-bun@v2
        with:
          bun-version: 1.3.14

      - name: Build ComfyUI bridge binaries
        shell: pwsh
        run: |
          $env:CGO_ENABLED = "0"
          $env:GOTELEMETRY = "off"
          Push-Location canvas-agent/native/comfy-bridge
          $env:GOOS = "windows"; $env:GOARCH = "amd64"
          go build -trimpath -ldflags="-s -w" -o ../../../web/public/InfiniteCanvas-ComfyBridge.exe .
          $env:GOOS = "linux"; $env:GOARCH = "amd64"
          go build -trimpath -ldflags="-s -w" -o ../../../web/public/InfiniteCanvas-ComfyBridge-linux-amd64 .
          $env:GOOS = "linux"; $env:GOARCH = "arm64"
          go build -trimpath -ldflags="-s -w" -o ../../../web/public/InfiniteCanvas-ComfyBridge-linux-arm64 .
          Pop-Location

      - name: Build web
        shell: pwsh
        working-directory: web
        env:
          CANVAS_PREBUILT_BRIDGE: "1"
        run: |
          bun install --frozen-lockfile
          bun run build

      - name: Build server and launcher
        shell: pwsh
        run: |
          New-Item -ItemType Directory -Force dist/InfiniteCanvas | Out-Null
          go build -trimpath -ldflags="-s -w" -o dist/InfiniteCanvas/server.exe .
          Push-Location packaging/windows-launcher
          $env:CGO_ENABLED = "0"
          go build -trimpath -ldflags="-s -w" -o ../../dist/InfiniteCanvas/InfiniteCanvas.exe .
          Pop-Location

      - name: Assemble portable package
        shell: pwsh
        run: |
          $target = "dist/InfiniteCanvas"
          New-Item -ItemType Directory -Force "$target/web" | Out-Null
          Copy-Item "web/.next/standalone/*" "$target/web" -Recurse -Force
          New-Item -ItemType Directory -Force "$target/web/.next" | Out-Null
          Copy-Item "web/.next/static" "$target/web/.next/static" -Recurse -Force
          New-Item -ItemType Directory -Force "$target/web/public" | Out-Null
          Copy-Item "web/public/*" "$target/web/public" -Recurse -Force
          Copy-Item "packaging/windows/env.example" "$target/.env" -Force
          Copy-Item "packaging/windows/README.txt" "$target/README.txt" -Force
          New-Item -ItemType Directory -Force "$target/data" | Out-Null
          Write-Host "package tree:"
          Get-ChildItem $target | Select-Object Name, Length

      - name: Bundle Node runtime
        shell: pwsh
        run: |
          $version = "v22.20.0"
          $archive = "node-$version-win-x64"
          Invoke-WebRequest "https://nodejs.org/dist/$version/$archive.zip" -OutFile node.zip
          Expand-Archive node.zip -DestinationPath node-runtime -Force
          New-Item -ItemType Directory -Force "dist/InfiniteCanvas/node" | Out-Null
          Copy-Item "node-runtime/$archive/node.exe" "dist/InfiniteCanvas/node/node.exe" -Force
          & "dist/InfiniteCanvas/node/node.exe" --version

      - name: Smoke test packaged app
        shell: pwsh
        run: |
          $target = (Resolve-Path "dist/InfiniteCanvas").Path
          $api = $null
          $web = $null
          try {
            $env:PORT = "8080"
            $api = Start-Process -FilePath "$target/server.exe" -WorkingDirectory $target -PassThru -NoNewWindow
            $env:PORT = "3000"
            $env:HOSTNAME = "127.0.0.1"
            $env:API_BASE_URL = "http://127.0.0.1:8080"
            $env:NODE_ENV = "production"
            $web = Start-Process -FilePath "$target/node/node.exe" -ArgumentList "web/server.js" -WorkingDirectory $target -PassThru -NoNewWindow
            $ready = $false
            for ($i = 0; $i -lt 60; $i++) {
              try {
                $response = Invoke-WebRequest -Uri "http://127.0.0.1:3000/api/settings" -UseBasicParsing -TimeoutSec 5
                if ($response.StatusCode -eq 200) { $ready = $true; break }
              } catch {
                Start-Sleep -Seconds 2
              }
            }
            if (-not $ready) { throw "前端 3000 未就绪" }
            $settings = Invoke-RestMethod -Uri "http://127.0.0.1:3000/api/settings" -TimeoutSec 10
            if ($settings.code -ne 0) { throw "settings 接口返回 code=$($settings.code)" }
            $page = Invoke-WebRequest -Uri "http://127.0.0.1:3000/" -UseBasicParsing -TimeoutSec 10
            if ($page.StatusCode -ne 200) { throw "首页返回 $($page.StatusCode)" }
            Write-Host "smoke ok: settings + 首页均正常"
          } finally {
            if ($web) { Stop-Process -Id $web.Id -Force -ErrorAction SilentlyContinue }
            if ($api) { Stop-Process -Id $api.Id -Force -ErrorAction SilentlyContinue }
          }

      - name: Package zip
        shell: pwsh
        run: |
          $tag = $env:GITHUB_REF_NAME
          if (-not $tag) { $tag = "manual-" + (Get-Date -Format "yyyyMMdd-HHmm") }
          $name = "InfiniteCanvas-Windows-x64-$tag.zip"
          $sevenZip = "C:\Program Files\7-Zip\7z.exe"
          if (Test-Path $sevenZip) {
            & $sevenZip a -tzip -mx=5 $name "dist\InfiniteCanvas" | Out-Null
          } else {
            Compress-Archive -Path "dist/InfiniteCanvas" -DestinationPath $name -CompressionLevel Optimal
          }
          if (-not (Test-Path $name)) { throw "打包失败：$name" }
          $hash = (Get-FileHash $name -Algorithm SHA256).Hash.ToLower()
          "$hash  $name" | Out-File "$name.sha256" -Encoding ascii
          "ASSET_NAME=$name" | Out-File $env:GITHUB_ENV -Append
          Get-Item $name | Select-Object Name, Length
          Write-Host "sha256: $hash"

      - uses: actions/upload-artifact@v4
        with:
          name: infinite-canvas-windows-portable
          path: |
            dist/InfiniteCanvas
          retention-days: 7

      - name: Publish release
        if: startsWith(github.ref, 'refs/tags/')
        shell: pwsh
        env:
          GH_TOKEN: ${{ github.token }}
          TAG: ${{ github.ref_name }}
        run: |
          $assets = @($env:ASSET_NAME, "$($env:ASSET_NAME).sha256")
          gh release view $env:TAG 2>$null
          if ($LASTEXITCODE -eq 0) {
            gh release upload $env:TAG @assets --clobber
          } else {
            gh release create $env:TAG @assets --title "$env:TAG Windows 便携版" --notes-file packaging/windows/RELEASE_NOTES.md --latest
          }
          gh release view $env:TAG --json url,assets --jq '.url, (.assets[] | .name + " " + (.size|tostring))'
